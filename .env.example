# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Must be an address Resend allows (verify domain in Resend, or use onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL="Stab <onboarding@resend.dev>"

# Inbox for contact form submissions
CONTACT_TO_EMAIL=contact@stab.agency

# Coming soon gate (middleware). Use 1/true to redirect all routes to /coming-soon.
# Set both on Vercel Production so the Edge middleware always sees the flag, then redeploy.
# COMING_SOON=0
# NEXT_PUBLIC_COMING_SOON=0
